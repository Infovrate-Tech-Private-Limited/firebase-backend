{
  "name": "@infovrate/firebase-backend",
  "version": "0.2.7",
  "description": "A package that helps with the management and expansion of a maintainable Firebase backend",
  "license": "MIT",
  "author": "Sahil Lathwal",
  "homepage": "https://github.com/Infovrate-Tech-Private-Limited/firebase-backend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infovrate-Tech-Private-Limited/firebase-backend.git"
  },
  "bugs": {
    "url": "https://github.com/Infovrate-Tech-Private-Limited/firebase-backend/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --sourcemap --watch --out-dir dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepack": "npm run build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/express-fileupload": "^1.5.1",
    "@types/glob": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "size-limit": "^12.0.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "express-fileupload": "^1.5.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "glob": "^11.0.0"
  }
}
